{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:display_context",
    "cases": [
      {
        "when": "gui",
        "model": {
          "type": "minecraft:model",
          "model": "enigmaticlegacy:item/gui/hunter_guidebook_gui"
        }
      },
      {
        "when": [
          "fixed",
          "ground"
        ],
        "model": {
          "type": "minecraft:model",
          "model": "enigmaticlegacy:item/3d/hunter_guidebook_3d"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:model",
      "model": "enigmaticlegacy:item/3d/hunter_guidebook_3d"
    }
  }
}
